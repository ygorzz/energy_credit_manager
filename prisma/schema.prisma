generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  companyId    String?
  hashPassword String
  role         UserRoles      @default(CLIENT)
  status       UserStatus     @default(ACTIVE)
  company      ClientCompany? @relation(fields: [companyId], references: [id])
}

model PowerPlant {
  id                  String                @id @default(uuid())
  name                String                @unique
  state               States
  city                String
  sourceType          PowerPlantSourceTypes @default(SOLAR)
  installedCapacityMw Decimal
  status              PowerPlantStatus      @default(ACTIVE)
  distributorId       String
  monthlyGenerations  MonthlyGeneration[]
  distributor         Distributor           @relation(fields: [distributorId], references: [id])
}

model ClientCompany {
  id                   String             @id @default(uuid())
  name                 String
  cnpj                 String             @unique
  allocationPercentage Int
  distributorId        String
  distributor          Distributor        @relation(fields: [distributorId], references: [id])
  creditAllocations    CreditAllocation[]
  users                User[]
}

model Distributor {
  id                         String                      @id @default(uuid())
  name                       String                      @unique
  clientCompanies            ClientCompany[]
  powerPlants                PowerPlant[]
  monthlyDistributorBalances MonthlyDistributorBalance[]
}

model MonthlyGeneration {
  id                 String     @id @default(uuid())
  month              Months
  year               Int
  energyGeneratedMwh Decimal
  powerPlantId       String
  powerPlant         PowerPlant @relation(fields: [powerPlantId], references: [id])

  @@unique([powerPlantId, year, month])
}

model MonthlyDistributorBalance {
  id                      String      @id @default(uuid())
  month                   Months
  year                    Int
  totalEnergyGeneratedMwh Decimal     @default(0)
  totalEnergyAllocatedMwh Decimal     @default(0)
  avaliableEnergyMwh      Decimal
  distributorId           String
  distributor             Distributor @relation(fields: [distributorId], references: [id])

  // creates a composting unique key -> distributorId_year_month
  @@unique([distributorId, year, month])
}

model CreditAllocation {
  id                 String        @id @default(uuid())
  month              Months
  year               Int
  percentageApplied  Decimal
  energyAllocatedMwh Decimal
  clientCompanyId    String
  clientCompany      ClientCompany @relation(fields: [clientCompanyId], references: [id])

  @@unique([clientCompanyId, year, month])
}

enum UserRoles {
  ADMIN
  ANALYST
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  CANCELED
}

enum PowerPlantSourceTypes {
  SOLAR
  HYDRO
  WIND
}

enum PowerPlantStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum Months {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

enum States {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}
