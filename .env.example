# Replace placeholders locally. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Run npx prisma db seed explicitly to bootstrap the first administrator.
# Password follows the user registration rules and is required only on initial creation.
# Existing administrators are preserved, including their password and status.
# An existing non-administrator account with this email causes an error, without promotion.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
